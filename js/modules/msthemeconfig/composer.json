{
  "name": "ijzershop/msthemeconfig",
  "description": "Prestashop Configuratie module voor de Moderne Smid webshops",
  "type": "prestashop-module",
  "license": "AFL-3.0",
  "require": {
    "php": ">=8.0.0",
    "ext-intl": "*",
    "ext-soap": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "jketelaar/php-kiyoh-api": "^2.1",
    "pcloud/pcloud-php-sdk": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "MsThemeConfig\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "prepend-autoloader": false
  },
  "authors": [
    {
      "name": "Jelmer Stoker",
