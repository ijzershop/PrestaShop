<div class="panel">
  <style>
    .ai-panel .grid { display:flex; gap:12px; flex-wrap:wrap; }
    .ai-panel .col  { flex:1 1 320px; min-width:280px; }
    .ai-panel .list { max-height:220px; overflow:auto; border:1px solid #ddd; padding:6px; border-radius:4px; background:#fff; }
    .ai-panel .muted { color:#666; font-size:12px; }
    .ai-panel .actions { margin-top:10px; }
    .ai-panel .drafts  { margin-top:12px; }
    .ai-panel .url-row { display:flex; gap:6px; margin-bottom:6px; }
    .ai-panel .url-row input { flex:1; }
    .ai-panel .btn { display:inline-block; font-weight:400; line-height:1.5; text-align:center; cursor:pointer; user-select:none; border:1px solid transparent; padding:.375rem .75rem; font-size:1rem; border-radius:.25rem; transition:color .15s,background-color .15s,border-color .15s; }
    .ai-panel .btn-default { color:#212529; background:#e9ecef; border-color:#ced4da; }
    .ai-panel .btn-default:hover { background:#dde1e4; }
    .ai-panel .btn-primary { color:#fff; background:#0d6efd; border-color:#0d6efd; }
    .ai-panel .btn-primary:hover { background:#0b5ed7; }
    .ai-panel .btn-warning { color:#000; background:#ffc107; border-color:#ffc107; }
    .ai-panel .btn-warning:hover { background:#ffca2c; }
    .ai-panel .btn-success { color:#fff; background:#198754; border-color:#198754; }
    .ai-panel .btn-success:hover { background:#157347; }
    .ai-panel .btn-danger  { color:#fff; background:#dc3545; border-color:#dc3545; }
    .ai-panel .btn-danger:hover  { background:#b02a37; }
    .ai-panel .btn-sm { padding:.2rem .5rem; font-size:.85rem; }
    .ai-panel .form-control { display:block; width:100%; padding:.375rem .75rem; font-size:1rem; color:#212529; background:#fff; border:1px solid #ced4da; border-radius:.25rem; }
    .ai-panel .form-control:focus { border-color:#86b7fe; outline:0; }
    .ai-panel label.checkbox { display:flex; align-items:center; gap:6px; font-weight:400; }
    .ai-panel .label { display:inline-block; padding:.25em .4em; font-size:75%; font-weight:700; color:#fff; border-radius:.25rem; }
    .ai-panel .label-default { background:#6c757d; }
    .ai-panel .label-info    { background:#0dcaf0; color:#000; }
    .ai-panel .label-warning { background:#ffc107; color:#212529; }
    .ai-panel .label-danger  { background:#dc3545; }
    .ai-panel .label-success { background:#198754; }
    .ai-panel .table { width:100%; margin-bottom:1rem; color:#212529; }
    .ai-panel .table th,.ai-panel .table td { padding:.5rem; border-top:1px solid #dee2e6; vertical-align:top; }
    .ai-panel .table thead th { border-bottom:2px solid #dee2e6; }
    .ai-panel .table-bordered,.ai-panel .table-bordered th,.ai-panel .table-bordered td { border:1px solid #dee2e6; }
    .ai-panel .table-striped tbody tr:nth-of-type(odd) { background:rgba(0,0,0,.02); }
    .ai-panel .table-sm th,.ai-panel .table-sm td { padding:.3rem .4rem; }
    .ai-panel .alert { padding:.75rem 1.25rem; border:1px solid transparent; border-radius:.25rem; margin:8px 0; }
    .ai-panel .alert-info    { color:#055160; background:#cff4fc; border-color:#b6effb; }
    .ai-panel .alert-warning { color:#664d03; background:#fff3cd; border-color:#ffecb5; }
    .ai-panel h3 { margin:0 0 12px; }
    .ai-panel .section { border:1px solid #dee2e6; border-radius:4px; padding:12px; margin-bottom:12px; }
    .ai-panel .section-title { font-weight:600; margin-bottom:8px; font-size:.95rem; }
    .ai-panel textarea.draft-long { font-family:monospace; font-size:12px; }
    .ai-panel .draft-name { font-size:.85rem; }
  </style>

  <div class="ai-panel">
    <h3><i class="icon-magic"></i> {{ 'AI product descriptions'|trans({}, 'Modules.MsThemeConfig.AIController') }}</h3>

    {# ── Provider + API key ─────────────────────────────────────────── #}
    <div class="section">
      <div class="section-title">AI provider &amp; API key</div>
      <div style="display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap">
        <div>
          <label style="font-weight:600;display:block;margin-bottom:4px">Provider</label>
          <select id="ai-provider" class="form-control" style="width:auto;min-width:220px">
            <option value="openai"{{ has_openai_key ? ' data-configured="1"' : '' }}>OpenAI — GPT-4o Mini ★ aanbevolen</option>
            <option value="anthropic"{{ has_anthropic_key ? ' data-configured="1"' : '' }}>Anthropic — Claude Sonnet</option>
            <option value="grok"{{ has_grok_key ? ' data-configured="1"' : '' }}>xAI — Grok 3 Mini (gratis tier)</option>
            <option value="copilot"{{ has_copilot_key ? ' data-configured="1"' : '' }}>GitHub Copilot — GPT-4o Mini</option>
          </select>
        </div>
        <div style="flex:1;min-width:260px;max-width:480px">
          <label style="font-weight:600;display:block;margin-bottom:4px">API key</label>
          <div style="display:flex;gap:8px;align-items:center">
            <input id="ai-api-key" type="password" class="form-control"
                   placeholder="Paste key here…" autocomplete="off" style="flex:1" />
            <button id="ai-save-key" class="btn btn-default">Save</button>
          </div>
          <div id="ai-key-status" class="muted" style="margin-top:4px">
            {% if has_anthropic_key %}✓ Anthropic key saved{% elseif has_grok_key %}✓ Grok key saved{% endif %}
          </div>
          <div id="ai-key-hint" class="muted" style="margin-top:4px"></div>
        </div>
      </div>
    </div>

    {# ── Settings row ──────────────────────────────────────────────── #}
    <div class="grid">
      <div class="col">
        <label>{{ 'Language'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
        <select id="ai-lang" class="form-control">
          {% for lang in languages %}
            <option value="{{ lang.id_lang }}"{{ lang.id_lang == default_lang_id ? ' selected' : '' }}>
              {{ lang.name }} ({{ lang.iso_code|upper }})
            </option>
          {% endfor %}
        </select>

        <div class="actions" style="margin-top:8px">
          <label class="checkbox">
            <input type="checkbox" id="ai-overwrite" />
            {{ 'Overwrite existing descriptions'|trans({}, 'Modules.MsThemeConfig.AIController') }}
          </label>
        </div>

        <div class="actions" style="margin-top:6px">
          <label class="checkbox">
            <input type="checkbox" id="ai-pinterest" checked />
            Pinterest inspiratie-link opnemen
          </label>
        </div>

        {% if shops|length > 1 %}
        <div class="actions" style="margin-top:8px">
          <label>Opslaan in winkel(s)</label>
          <div style="margin-top:4px">
            <label class="checkbox" style="margin-bottom:4px">
              <input type="checkbox" id="ai-shop-all" checked onchange="toggleShopAll(this)" />
              <strong>Alle winkels</strong>
            </label>
            {% for shop in shops %}
            <label class="checkbox" style="margin-left:12px;margin-bottom:2px">
              <input type="checkbox" class="ai-shop-cb" value="{{ shop.id_shop }}" />
              {{ shop.name }}
            </label>
            {% endfor %}
          </div>
          <div class="muted" style="font-size:11px;margin-top:3px">
            Beschrijvingen zijn globaal (PS product_lang). Specifieke winkel activeert het product in die winkel.
          </div>
        </div>
        {% endif %}

        <div class="actions" style="margin-top:6px">
          <label class="checkbox">
            <input type="checkbox" id="ai-generate-meta" checked />
            Meta description &amp; keywords genereren
          </label>
        </div>

        <div class="actions" style="margin-top:6px">
          <label class="checkbox">
            <input type="checkbox" id="ai-generate-jsonld" />
            SEO JSON-LD (FAQ Q&amp;A voor Google) genereren
          </label>
        </div>

        <div class="actions" style="margin-top:8px">
          <label>{{ 'Batch size'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
          <select id="ai-batch" class="form-control" style="display:inline-block;width:auto;margin-right:6px">
            <option>5</option><option>10</option><option selected>15</option><option>20</option><option>25</option>
          </select>
        </div>
      </div>

      <div class="col">
        <label>{{ 'Categories'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
        <div id="ai-categories" class="list"></div>
        <div class="muted">{{ 'Filter products by category'|trans({}, 'Modules.MsThemeConfig.AIController') }}</div>
      </div>

      <div class="col">
        <label style="display:flex;justify-content:space-between;align-items:center">
          <span>{{ 'Products'|trans({}, 'Modules.MsThemeConfig.AIController') }}
            <span id="ai-product-count" class="label label-default" style="margin-left:6px;font-size:11px">0</span>
            <span id="ai-product-selected" class="label label-info" style="margin-left:4px;font-size:11px;display:none">0 selected</span>
          </span>
          <button id="ai-select-all-products" class="btn btn-default btn-sm" type="button" title="Select all visible products">Select all</button>
        </label>
        <input id="ai-product-search" class="form-control" placeholder="{{ 'Search by name or reference'|trans({}, 'Modules.MsThemeConfig.AIController') }}" style="margin-bottom:6px" />
        <div id="ai-products" class="list"></div>
        <div class="muted">{{ 'Select products, or select a category to auto-select all in it'|trans({}, 'Modules.MsThemeConfig.AIController') }}</div>
      </div>
    </div>

    {# ── System context ────────────────────────────────────────────── #}
    <div class="section" style="margin-top:12px">
      <div class="section-title" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px">
        <span>System context <span class="muted">(sent as AI system prompt)</span></span>
        <div style="display:flex;align-items:center;gap:8px">
          {% if ai_contexts|length > 1 %}
          <select id="ai-context-select" class="form-control" style="width:auto;min-width:180px;font-size:13px">
            {% for ctx in ai_contexts %}
              <option value="{{ ctx.name }}">{{ ctx.label }}</option>
            {% endfor %}
          </select>
          {% endif %}
          <span class="muted" style="font-size:11px">
            <code>config/contexts/</code>
          </span>
        </div>
      </div>
      <textarea id="ai-system-context" class="form-control" rows="8" style="font-family:monospace;font-size:12px">{{ default_system_context }}</textarea>
    </div>

    {# ── Extra context + URLs ──────────────────────────────────────── #}
    <div class="grid" style="margin-top:0">
      <div class="col">
        <label>{{ 'Extra context (tone, keywords, constraints)'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
        <textarea id="ai-context" class="form-control" rows="3" placeholder="{{ 'e.g., Friendly expert tone, highlight durability and warranty, avoid jargon'|trans({}, 'Modules.MsThemeConfig.AIController') }}"></textarea>

        <div class="actions" style="margin-top:10px">
          <label>{{ 'Optional web locations to fetch and summarize'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
          <div id="ai-urls">
            <div class="url-row"><input type="url" class="form-control" placeholder="https://example.com/page" /><button class="btn btn-default ai-url-remove" type="button">&times;</button></div>
          </div>
          <button id="ai-url-add" class="btn btn-default" type="button"><i class="icon-plus"></i> {{ 'Add URL'|trans({}, 'Modules.MsThemeConfig.AIController') }}</button>
        </div>
      </div>
    </div>
      <div class="grid" style="margin-top:0">

      <div class="col">
        <label>{{ 'Related features'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
        <div id="ai-features" class="list" style="max-height:300px"></div>
      </div>
        <div class="col">
        <label>{{ 'Related attributes'|trans({}, 'Modules.MsThemeConfig.AIController') }}</label>
        <div id="ai-attributes" class="list" style="max-height:300px"></div>
      </div>
    </div>

    {# ── Generate button + log ─────────────────────────────────────── #}
    <div class="actions" style="margin-top:12px">
      <button id="ai-generate" class="btn btn-primary"><i class="icon-cogs"></i> {{ 'Generate drafts'|trans({}, 'Modules.MsThemeConfig.AIController') }}</button>
      <span id="ai-status" class="label label-default" style="margin-left:8px">{{ 'Idle'|trans({}, 'Modules.MsThemeConfig.AIController') }}</span>
    </div>

    <div id="ai-log" class="list" style="margin-top:8px; height:120px; font-family:monospace; font-size:12px;"></div>

    {# ── Drafts table ──────────────────────────────────────────────── #}
    <div class="drafts">
      <table class="table table-bordered table-striped table-sm" id="ai-drafts-table" style="display:none">
        <thead>
          <tr>
            <th style="width:32px"><input type="checkbox" id="ai-drafts-checkall" /></th>
            <th style="width:140px">{{ 'Product'|trans({}, 'Modules.MsThemeConfig.AIController') }}</th>
            <th style="width:240px">{{ 'Short description'|trans({}, 'Modules.MsThemeConfig.AIController') }}</th>
            <th>{{ 'Long description (HTML)'|trans({}, 'Modules.MsThemeConfig.AIController') }}</th>
            <th style="width:220px">SEO JSON-LD</th>
            <th style="width:90px"></th>
          </tr>
        </thead>
        <tbody id="ai-drafts-body"></tbody>
      </table>
      <div class="actions" id="ai-drafts-actions" style="display:none">
        <button id="ai-save-selected" class="btn btn-warning"><i class="icon-save"></i> {{ 'Save selected'|trans({}, 'Modules.MsThemeConfig.AIController') }}</button>
        <button id="ai-save-all" class="btn btn-success"><i class="icon-save"></i> {{ 'Save all'|trans({}, 'Modules.MsThemeConfig.AIController') }}</button>
      </div>
    </div>
  </div>{# /ai-panel #}
</div>

<script>
(function(){
  const ajaxUrl = '{{ ajax_url | raw }}';

  // ── context switcher ─────────────────────────────────────────────────────
  const aiContexts = {
    {% for ctx in ai_contexts %}
    {{ ctx.name | json_encode | raw }}: {{ ctx.content | json_encode | raw }}{% if not loop.last %},{% endif %}
    {% endfor %}
  };

  const $ctxSelect = document.getElementById('ai-context-select');
  if ($ctxSelect) {
    $ctxSelect.addEventListener('change', function() {
      const content = aiContexts[this.value];
      if (content !== undefined) {
        document.getElementById('ai-system-context').value = content;
      }
    });
  }

  const $cat    = document.getElementById('ai-categories');
  const $prod   = document.getElementById('ai-products');
  const $feat   = document.getElementById('ai-features');
  const $attr   = document.getElementById('ai-attributes');
  const $log    = document.getElementById('ai-log');
  const $status = document.getElementById('ai-status');
  const $search = document.getElementById('ai-product-search');

  // ── helpers ──────────────────────────────────────────────────────────────

  function log(msg) {
    const div = document.createElement('div');
    div.textContent = '[' + new Date().toLocaleTimeString() + '] ' + msg;
    $log.appendChild(div);
    $log.scrollTop = $log.scrollHeight;
  }

  function setStatus(t, cls) {
    $status.textContent = t;
    $status.className   = 'label ' + (cls || 'label-default');
  }

  function esc(s) {
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function getSelectedIds(container) {
    return Array.from(container.querySelectorAll('input[type="checkbox"]:checked')).map(x => x.value);
  }

  function renderList(container, items, idKey, labelFn, autoCheck) {
    container.innerHTML = '';
    items.forEach(function(it) {
      const row = document.createElement('label');
      row.style.display = 'block';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.value = it[idKey];
      cb.checked = !!autoCheck;
      cb.style.marginRight = '6px';
      row.appendChild(cb);
      row.appendChild(document.createTextNode(labelFn(it)));
      container.appendChild(row);
    });
  }

  function getLangId() {
    return document.getElementById('ai-lang').value;
  }

  // ── load categories ───────────────────────────────────────────────────────

  function loadCategories() {
    setStatus('Loading categories…', 'label-info');
    fetch(ajaxUrl + '&action=ListCategories&id_lang=' + getLangId(), { credentials:'same-origin' })
      .then(r => r.json()).then(j => {
        if (!j || !j.ok) { setStatus('Failed', 'label-danger'); return; }
        renderList($cat, j.categories || [], 'id_category', it => it.label || it.name);
        setStatus('Idle');
      }).catch(() => setStatus('Failed', 'label-danger'));
  }

  // ── load products ─────────────────────────────────────────────────────────

  let _autoSelectAll = false; // flag set when a category is chosen

  function updateProductCountBadges() {
    const all      = $prod.querySelectorAll('input[type="checkbox"]');
    const checked  = $prod.querySelectorAll('input[type="checkbox"]:checked');
    document.getElementById('ai-product-count').textContent    = all.length;
    const selBadge = document.getElementById('ai-product-selected');
    if (checked.length > 0) {
      selBadge.textContent = checked.length + ' selected';
      selBadge.style.display = '';
    } else {
      selBadge.style.display = 'none';
    }
  }

  function loadProducts(autoSelect) {
    const ids = getSelectedIds($cat).join(',');
    const q   = encodeURIComponent($search.value.trim());
    setStatus('Loading products…', 'label-info');
    _autoSelectAll = !!autoSelect;
    fetch(ajaxUrl + '&action=ListProducts&limit=500&id_lang=' + getLangId()
        + '&category_ids=' + encodeURIComponent(ids) + (q ? ('&q=' + q) : ''),
      { credentials:'same-origin' })
      .then(r => r.json()).then(j => {
        if (!j || !j.ok) { setStatus('Failed', 'label-danger'); return; }
        renderList($prod, j.products || [], 'id_product',
          it => '#' + it.id_product + ' ' + (it.name || '') + (it.reference ? ' [' + it.reference + ']' : ''));
        if (_autoSelectAll) {
          $prod.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = true);
        }
        updateProductCountBadges();
        setStatus('Idle');
      }).catch(() => setStatus('Failed', 'label-danger'));
  }

  // ── load features / attributes ────────────────────────────────────────────

  function loadFeaturesAttributes() {
    const pids = getSelectedIds($prod).join(',');
    if (!pids) { $feat.innerHTML = ''; $attr.innerHTML = ''; return; }
    setStatus('Loading features/attributes…', 'label-info');
    fetch(ajaxUrl + '&action=ListFeaturesAttributes&id_lang=' + getLangId()
        + '&product_ids=' + encodeURIComponent(pids),
      { credentials:'same-origin' })
      .then(r => r.json()).then(j => {
        if (!j || !j.ok) { setStatus('Failed', 'label-danger'); return; }
        renderList($feat, j.features || [],   'id_feature',   it => it.feature_name + ': ' + it.feature_value, true);
        renderList($attr, j.attributes || [], 'id_attribute', it => it.group_name   + ': ' + it.attribute_name, true);
        setStatus('Idle');
      }).catch(() => setStatus('Failed', 'label-danger'));
  }

  // ── URL rows ──────────────────────────────────────────────────────────────

  document.getElementById('ai-url-add').addEventListener('click', function() {
    const wrap = document.getElementById('ai-urls');
    const row  = document.createElement('div');
    row.className = 'url-row';
    row.innerHTML = '<input type="url" class="form-control" placeholder="https://example.com/page" />'
                  + '<button class="btn btn-default ai-url-remove" type="button">&times;</button>';
    wrap.appendChild(row);
  });
  document.getElementById('ai-urls').addEventListener('click', function(ev) {
    if (ev.target && ev.target.classList.contains('ai-url-remove')) {
      ev.target.parentElement.remove();
    }
  });

  // ── provider selector: update key status hint ────────────────────────────

  const providerConfigs = {
    anthropic: {{ has_anthropic_key ? 'true' : 'false' }},
    grok:      {{ has_grok_key      ? 'true' : 'false' }},
    openai:    {{ has_openai_key    ? 'true' : 'false' }},
    copilot:   {{ has_copilot_key   ? 'true' : 'false' }},
  };

  const providerLabels = {
    anthropic: 'Anthropic',
    grok:      'Grok (xAI)',
    openai:    'OpenAI',
    copilot:   'GitHub Copilot',
  };

  const providerKeyLinks = {
    anthropic: 'Get key: <a href="https://console.anthropic.com/settings/keys" target="_blank">console.anthropic.com</a>',
    grok:      'Get key: <a href="https://console.x.ai/" target="_blank">console.x.ai</a> — free tier available',
    openai:    'Get key: <a href="https://platform.openai.com/api-keys" target="_blank">platform.openai.com</a>',
    copilot:   'Requires GitHub Copilot Business/Enterprise. Key = GitHub PAT with <code>copilot</code> scope.',
  };

  function updateProviderHints() {
    const p   = document.getElementById('ai-provider').value;
    const $ks = document.getElementById('ai-key-status');
    $ks.textContent = providerConfigs[p] ? '✓ ' + providerLabels[p] + ' key saved' : '';
    document.getElementById('ai-key-hint').innerHTML = providerKeyLinks[p] || '';
  }

  document.getElementById('ai-provider').addEventListener('change', updateProviderHints);
  updateProviderHints(); // init

  // ── API key save ──────────────────────────────────────────────────────────

  document.getElementById('ai-save-key').addEventListener('click', function() {
    const key      = document.getElementById('ai-api-key').value.trim();
    const provider = document.getElementById('ai-provider').value;
    if (!key) { alert('Enter an API key first.'); return; }
    const params = new URLSearchParams({ api_key: key });
    fetch(ajaxUrl + '&action=SaveConfig&provider=' + encodeURIComponent(provider), {
      method:'POST', credentials:'same-origin',
      headers:{ 'Content-Type':'application/x-www-form-urlencoded' },
      body: params.toString()
    }).then(r => r.json()).then(j => {
      if (j && j.ok) {
        providerConfigs[provider] = true;
        document.getElementById('ai-key-status').textContent = '✓ ' + providerLabels[provider] + ' key saved';
        document.getElementById('ai-api-key').value = '';
      } else {
        alert('Error: ' + (j && j.error ? j.error : 'unknown'));
      }
    }).catch(() => alert('Request failed'));
  });

  // ── generate drafts ───────────────────────────────────────────────────────

  document.getElementById('ai-generate').addEventListener('click', function() {
    const pids = getSelectedIds($prod);
    if (!pids.length) { alert('Select at least one product first.'); return; }

    const apiKey    = document.getElementById('ai-api-key').value.trim();
    const provider  = document.getElementById('ai-provider').value;
    const systemCtx = document.getElementById('ai-system-context').value.trim();
    const extraCtx  = document.getElementById('ai-context').value.trim();
    const overwrite      = document.getElementById('ai-overwrite').checked      ? '1' : '0';
    const pinterest      = document.getElementById('ai-pinterest').checked      ? '1' : '0';
    const generateMeta   = document.getElementById('ai-generate-meta').checked  ? '1' : '0';
    const generateJsonld = document.getElementById('ai-generate-jsonld').checked ? '1' : '0';
    const idLang    = getLangId();

    setStatus('Generating…', 'label-warning');
    log('Sending ' + pids.length + ' product(s) to ' + (providerLabels[provider] || provider) + ' for generation…');

    // Hide old drafts
    document.getElementById('ai-drafts-table').style.display   = 'none';
    document.getElementById('ai-drafts-actions').style.display = 'none';
    document.getElementById('ai-drafts-body').innerHTML = '';

    // action + provider go in the URL so PS legacy controller reads them from $_GET reliably
    const generateUrl = ajaxUrl + '&action=GenerateDrafts&provider=' + encodeURIComponent(provider);

    const featureIds   = getSelectedIds($feat).join(',');
    const attributeIds = getSelectedIds($attr).join(',');

    const params = new URLSearchParams({
      product_ids:    pids.join(','),
      id_lang:        idLang,
      extra_context:  extraCtx,
      system_context: systemCtx,
      overwrite:       overwrite,
      pinterest:       pinterest,
      generate_meta:   generateMeta,
      generate_jsonld: generateJsonld,
      feature_ids:    featureIds,
      attribute_ids:  attributeIds,
    });
    if (apiKey) {
      params.set('api_key', apiKey);
    }

    fetch(generateUrl, {
      method:'POST', credentials:'same-origin',
      headers:{ 'Content-Type':'application/x-www-form-urlencoded' },
      body: params.toString()
    })
    .then(r => r.json())
    .then(j => {
      if (!j || !j.ok) {
        setStatus('Failed', 'label-danger');
        log('Error: ' + (j && j.error ? j.error : 'Unknown error'));
        return;
      }
      const drafts = j.drafts || [];
      const ok   = drafts.filter(d => !d.error && !d.skipped).length;
      const skip = drafts.filter(d => d.skipped).length;
      const err  = drafts.filter(d => d.error).length;
      setStatus('Done', 'label-success');
      log('Done — ' + ok + ' generated' + (skip ? ', ' + skip + ' skipped' : '') + (err ? ', ' + err + ' errors' : '') + '.');
      renderDrafts(drafts);
    })
    .catch(err => {
      setStatus('Failed', 'label-danger');
      log('Request error: ' + err.message);
    });
  });

  // ── render drafts table ───────────────────────────────────────────────────

  function renderDrafts(drafts) {
    const tbody = document.getElementById('ai-drafts-body');
    tbody.innerHTML = '';

    drafts.forEach(function(d) {
      const tr = document.createElement('tr');
      tr.dataset.productId = d.id_product;

      if (d.error) {
        tr.innerHTML = '<td></td>'
          + '<td class="draft-name">' + esc(d.name || '#' + d.id_product) + '</td>'
          + '<td colspan="3" style="color:#dc3545">Error: ' + esc(d.error) + '</td>';
      } else if (d.skipped) {
        tr.innerHTML = '<td></td>'
          + '<td class="draft-name">' + esc(d.name || '#' + d.id_product) + '</td>'
          + '<td colspan="3" class="muted">Skipped: ' + esc(d.reason || '') + '</td>';
      } else {
        const hasMeta = d.meta_description !== undefined || d.meta_keywords !== undefined;
        tr.innerHTML = '<td><input type="checkbox" class="draft-cb" data-id="' + d.id_product + '" checked /></td>'
          + '<td class="draft-name">' + esc(d.name || '#' + d.id_product) + '</td>'
          + '<td>'
            + '<textarea class="form-control draft-short" data-id="' + d.id_product + '" rows="3">' + esc(d.short_description || '') + '</textarea>'
            + (hasMeta
              ? '<div style="margin-top:6px">'
                + '<div class="muted" style="margin-bottom:2px">Meta description <span style="color:#888">(max 155 tekens)</span></div>'
                + '<textarea class="form-control draft-meta-desc" data-id="' + d.id_product + '" rows="2" maxlength="155">' + esc(d.meta_description || '') + '</textarea>'
                + '<div class="muted" style="margin:4px 0 2px">Meta keywords</div>'
                + '<input type="text" class="form-control draft-meta-keys" data-id="' + d.id_product + '" value="' + esc(d.meta_keywords || '') + '" />'
                + '</div>'
              : '')
          + '</td>'
          + '<td><textarea class="form-control draft-long" data-id="' + d.id_product + '" rows="8">'
            + esc(d.long_description || '') + '</textarea></td>'
          + '<td>'
            + (d.seo_jsonld !== undefined
              ? '<textarea class="form-control draft-jsonld" data-id="' + d.id_product + '" rows="8" style="font-family:monospace;font-size:11px">'
                + esc(d.seo_jsonld || '') + '</textarea>'
              : '<span class="muted" style="font-size:11px">—</span>')
          + '</td>'
          + '<td style="white-space:nowrap">'
            + '<button class="btn btn-default btn-sm btn-regen" data-id="' + d.id_product + '" title="Regenerate">&#x21bb;</button>'
          + '</td>';
      }
      tbody.appendChild(tr);
    });

    if (tbody.children.length) {
      document.getElementById('ai-drafts-table').style.display   = '';
      document.getElementById('ai-drafts-actions').style.display = '';
    }

    // Check-all toggle
    document.getElementById('ai-drafts-checkall').addEventListener('change', function() {
      tbody.querySelectorAll('.draft-cb').forEach(cb => cb.checked = this.checked);
    });
  }

  // ── collect + save ────────────────────────────────────────────────────────

  function collectDrafts(selectedOnly) {
    const result = [];
    document.querySelectorAll('#ai-drafts-body tr').forEach(function(tr) {
      const cb = tr.querySelector('.draft-cb');
      if (!cb) return;
      if (selectedOnly && !cb.checked) return;
      const draft = {
        id_product:        parseInt(cb.dataset.id),
        short_description: (tr.querySelector('.draft-short') || {}).value || '',
        long_description:  (tr.querySelector('.draft-long')  || {}).value || '',
      };
      const metaDesc  = tr.querySelector('.draft-meta-desc');
      const metaKeys  = tr.querySelector('.draft-meta-keys');
      const jsonldEl  = tr.querySelector('.draft-jsonld');
      if (metaDesc) draft.meta_description = metaDesc.value || '';
      if (metaKeys) draft.meta_keywords    = metaKeys.value || '';
      if (jsonldEl) draft.seo_jsonld       = jsonldEl.value || '';
      result.push(draft);
    });
    return result;
  }

  function getShopIds() {
    const allCb = document.getElementById('ai-shop-all');
    if (!allCb || allCb.checked) return '0'; // 0 = all shops
    const checked = [...document.querySelectorAll('.ai-shop-cb:checked')].map(cb => cb.value);
    return checked.length ? checked.join(',') : '0';
  }

  function toggleShopAll(masterCb) {
    document.querySelectorAll('.ai-shop-cb').forEach(cb => {
      cb.checked = false;
      cb.disabled = masterCb.checked;
    });
  }
  // Disable individual shop checkboxes initially (all-shops is default)
  document.querySelectorAll('.ai-shop-cb').forEach(cb => cb.disabled = true);

  function saveDrafts(drafts) {
    if (!drafts.length) { alert('No drafts to save.'); return; }
    setStatus('Saving…', 'label-warning');
    log('Saving ' + drafts.length + ' product(s)…');

    const params = new URLSearchParams({
      id_lang:  getLangId(),
      shop_ids: getShopIds(),
      drafts:   JSON.stringify(drafts),
    });

    fetch(ajaxUrl + '&action=SaveDrafts', {
      method:'POST', credentials:'same-origin',
      headers:{ 'Content-Type':'application/x-www-form-urlencoded' },
      body: params.toString()
    })
    .then(r => r.json())
    .then(j => {
      if (!j || !j.ok) {
        setStatus('Save failed', 'label-danger');
        log('Save error: ' + (j && j.error ? j.error : 'Unknown'));
        return;
      }
      setStatus('Saved', 'label-success');
      log('Saved ' + j.saved + ' product(s).' + (j.errors && j.errors.length ? ' Errors: ' + j.errors.join('; ') : ''));
    })
    .catch(err => {
      setStatus('Save failed', 'label-danger');
      log('Save error: ' + err.message);
    });
  }

  document.getElementById('ai-save-selected').addEventListener('click', function() {
    saveDrafts(collectDrafts(true));
  });
  document.getElementById('ai-save-all').addEventListener('click', function() {
    saveDrafts(collectDrafts(false));
  });

  // ── event wiring ──────────────────────────────────────────────────────────

  // Auto-select all products when a category checkbox changes
  $cat.addEventListener('change', function() {
    loadProducts(true); // true = auto-select all loaded products
  });

  $search.addEventListener('input', function() {
    clearTimeout($search.__t);
    $search.__t = setTimeout(function(){ loadProducts(false); }, 400);
  });

  $prod.addEventListener('change', function() {
    updateProductCountBadges();
    loadFeaturesAttributes();
  });

  document.getElementById('ai-select-all-products').addEventListener('click', function() {
    const all = $prod.querySelectorAll('input[type="checkbox"]');
    const anyUnchecked = Array.from(all).some(cb => !cb.checked);
    all.forEach(cb => cb.checked = anyUnchecked); // toggle: select all or deselect all
    this.textContent = anyUnchecked ? 'Deselect all' : 'Select all';
    updateProductCountBadges();
    loadFeaturesAttributes();
  });
  document.getElementById('ai-lang').addEventListener('change', function() {
    loadCategories();
  });

  // ── boot ─────────────────────────────────────────────────────────────────
  loadCategories();
})();
</script>
