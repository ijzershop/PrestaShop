    // Make HTML5 required fields apply only when visible (active tab/open collapse)
    (function requiredOnlyWhenVisible(){
      function isLogicallyVisible(el){
        try{
          var $ = window.jQuery || window.$;
          if(!$){ return true; }
          var $el = $(el);
          // Hidden by type or disabled - ignore
          if ($el.is(':disabled')) { return false; }
          // If inside a tab-pane that is not active/show/visible -> not visible
          var $pane = $el.closest('.tab-pane');
          if ($pane.length && !($pane.hasClass('active') || $pane.hasClass('show') || $pane.is(':visible'))) {
            return false;
          }
          // If inside a collapsed section that is not open -> not visible
          var $collapse = $el.closest('.collapse');
          if ($collapse.length && !($collapse.hasClass('in') || $collapse.hasClass('show') || $collapse.is(':visible'))) {
            return false;
          }
          return true;
        } catch(e){
          return true;
        }
      }

      function tempStripHiddenRequired($form){
        var stripped = [];
        var $ = window.jQuery || window.$;
        if(!$){ return stripped; }
        $form.find('input[required], select[required], textarea[required]').each(function(){
          if(!isLogicallyVisible(this)){
            // Remember and strip
            this.setAttribute('data-was-required','1');
            this.removeAttribute('required');
            stripped.push(this);
          }
        });
        return stripped;
      }

      function restoreRequired(nodes){
        for (var i=0; i<nodes.length; i++){
          var el = nodes[i];
          if (el && el.getAttribute && el.getAttribute('data-was-required') === '1'){
            el.setAttribute('required','required');
            el.removeAttribute('data-was-required');
          }
        }
      }

      function attach(){
        var $ = window.jQuery || window.$;
        if(!$){ return; }
        var $form = $('#modernesmid-theme-config-form');
        if(!$form.length){ $form = $('form[action*="msthemeconfig"]:has(#modernesmid-config-tab-content)'); }
        if(!$form.length){ return; }

        // Intercept clicks on submit buttons to strip hidden requireds BEFORE native validation runs
        $form.on('click', 'button[type="submit"], input[type="submit"]', function(){
          var stripped = tempStripHiddenRequired($form);
          // Restore after the browser processes the submission/validation cycle
          setTimeout(function(){ restoreRequired(stripped); }, 0);
        });
      }

      if(document.readyState === 'loading'){
        document.addEventListener('DOMContentLoaded', attach);
      } else {
        attach();
      }
    })();

  </script>
