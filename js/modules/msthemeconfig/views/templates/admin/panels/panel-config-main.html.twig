<div class="card">
  <div class="card-header">
    Statussen, Carriers etc.
  </div>
  <div class="card-body">

      {#   Admin Header Logo   #}
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> Admin Header-logo
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseAdminLogo" aria-expanded="false" aria-controls="collapseAdminLogo">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseAdminLogo">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 text-right">
            Admin Header-logo (SVG)
          </label>
          <div class="col-xs-8">
            {% if MSTHEMECONFIG_ADMIN_HEADER_LOGO %}
              <div class="mb-2">
                <img src="{{ module_dir }}views/img/{{ MSTHEMECONFIG_ADMIN_HEADER_LOGO }}" alt="Huidig Admin‑logo" style="max-height: 50px; background: #f5f5f5; padding: 5px;">
              </div>
            {% endif %}
            <input type="file" name="MSTHEMECONFIG_ADMIN_HEADER_LOGO"
                   id="MSTHEMECONFIG_ADMIN_HEADER_LOGO"
                   accept=".svg,image/svg+xml"
                   class="form-control">
            <p class="help-block">
              Upload een SVG logo voor de admin header. Dit logo wordt getoond in de backend en is multistore-specifiek.
            </p>
          </div>
        </div>
      </div>

      {#   Custom Product   #}
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> Aangepast product
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseCustomProduct" aria-expanded="false" aria-controls="collapseCustomProduct">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseCustomProduct">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Categorie voor Custom Product
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_CUSTOM_PRODUCT_CATEGORY"
                    class="w-100 form-control select2-data-input" data-type="categories_home"
                    id="MSTHEMECONFIG_CUSTOM_PRODUCT_CATEGORY">
              {{ MSTHEMECONFIG_CUSTOM_PRODUCT_CATEGORY|raw }}
            </select>
            <p class="help-block">
              Selecteer de categorie die je wilt gebruiken voor aangepaste producten die worden toegevoegd
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Categorie voor Interne werkzaamheden producten
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_CUSTOM_INTERNAL_COSTS_PRODUCT_CATEGORY"
                    class="w-100 form-control select2-data-input" data-type="categories_home"
                    id="MSTHEMECONFIG_CUSTOM_INTERNAL_COSTS_PRODUCT_CATEGORY">
              {{ MSTHEMECONFIG_CUSTOM_INTERNAL_COSTS_PRODUCT_CATEGORY|raw }}
            </select>
            <p class="help-block">
              Selecteer de categorie die u wilt gebruiken om uw werkzaamheden producten in op te slaan
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Tijd gerelateerde producten
          </label>
          <div class="col-xs-8">
            <input name="MSTHEMECONFIG_TIME_BASED_PRODUCTS" type="text"
                   id="MSTHEMECONFIG_TIME_BASED_PRODUCTS"
                   value="{{ MSTHEMECONFIG_TIME_BASED_PRODUCTS }}">
            <p class="help-block">
              Selecteer de producten die u gebruikt bij offertes om minuten door te voeren. Hiermee wordt een extra vak toegevoegd die de uren omzet naar minuten.
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Custom Product Referentie
          </label>
          <div class="col-xs-8">
            <input type="text" name="MSTHEMECONFIG_CUSTOM_PRODUCT_REFERENCE"
                   id="MSTHEMECONFIG_CUSTOM_PRODUCT_REFERENCE"
                   value="{{ MSTHEMECONFIG_CUSTOM_PRODUCT_REFERENCE }}" class="form-control">
            <p class="help-block">
              Voer de referentienaam in voor aangepaste producten die bij de winkelwagen worden toegevoegd
            </p>
          </div>
        </div>
      </div>
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> Statussen
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseState" aria-expanded="false" aria-controls="collapseState">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseState">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Status voor Bestelling betaald
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_ORDERSTATE_PAID" class="w-100 form-control select2-data-input"
                    data-type="order_states" id="MSTHEMECONFIG_ORDERSTATE_PAID">
              {{ MSTHEMECONFIG_ORDERSTATE_PAID|raw }}
            </select>
            <p class="help-block">
              Select the orderstate of order paid, to disallow setting multiple times state paid
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Status voor bestelling gratis
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_ORDERSTATE_FREE_ORDER"
                    class="w-100 form-control select2-data-input" data-type="order_states"
                    id="MSTHEMECONFIG_ORDERSTATE_FREE_ORDER">
              {{ MSTHEMECONFIG_ORDERSTATE_FREE_ORDER|raw }}
            </select>
            <p class="help-block">
              Select the orderstate of free orders
            </p>
          </div>
        </div>
      </div>
      {# Carriers #}
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> Verzend opties
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseCarrier" aria-expanded="false" aria-controls="collapseCarrier">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseCarrier">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Set the shipping carrier
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_SHIPPING_CARRIER" class="w-100 form-control select2-data-input"
                    data-type="carriers" id="MSTHEMECONFIG_SHIPPING_CARRIER">
              {{ MSTHEMECONFIG_SHIPPING_CARRIER|raw }}
            </select>
            <p class="help-block">
              Shipping Carrier
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Set the pickup carrier
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_PICKUP_CARRIER" class="w-100 form-control select2-data-input"
                    data-type="carriers" id="MSTHEMECONFIG_PICKUP_CARRIER">
              {{ MSTHEMECONFIG_PICKUP_CARRIER|raw }}
            </select>
            <p class="help-block">
              Pickup Carrier
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Set the add to order carrier
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_ADD2ORDER_CARRIER" class="w-100 form-control select2-data-input"
                    data-type="carriers" id="MSTHEMECONFIG_ADD2ORDER_CARRIER">
              {{ MSTHEMECONFIG_ADD2ORDER_CARRIER|raw }}
            </select>
            <p class="help-block">
              AddToOrder Carrier
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 required text-right">
            Replacement Address
          </label>
          <div class="col-xs-8">
            <select name="MSTHEMECONFIG_CUSTOM_ADDRESS_WHEN_FAIL" class="w-100 form-control select2-data-input"
                    data-type="addresses" id="MSTHEMECONFIG_CUSTOM_ADDRESS_WHEN_FAIL">
              {{ MSTHEMECONFIG_CUSTOM_ADDRESS_WHEN_FAIL|raw }}
            </select>
            <p class="help-block">
              Set the replacement address when address id is available but the address record is missing. This is mostly for viewing purposes, records will not be updated.
            </p>
          </div>
        </div>
      </div>

      {# WebP #}
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> WebP afbeeldingen
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseWebP" aria-expanded="false" aria-controls="collapseWebP">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseWebP">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 text-right">
            Gebruik WebP afbeeldingen
          </label>
          <div class="col-xs-8">
            <div class="radio">
              <label><input type="radio" name="MSTHEMECONFIG_USE_WEBP" id="MSTHEMECONFIG_USE_WEBP_YES"
                            value="1"
                            {% if MSTHEMECONFIG_USE_WEBP == 1 %}checked="checked"{% endif %}>Ja</label>
            </div>
            <div class="radio">
              <label><input type="radio" name="MSTHEMECONFIG_USE_WEBP" id="MSTHEMECONFIG_USE_WEBP_NO"
                            value="0"
                            {% if MSTHEMECONFIG_USE_WEBP == 0 %}checked="checked"{% endif %}>Nee</label>
            </div>
            <p class="help-block">
              Wanneer ingeschakeld, worden product- en categorieafbeeldingen geserveerd als WebP (met JPG als fallback als de browser het niet ondersteunt, mits correct geïmplementeerd met picture tags). Opmerking: Deze switch verandert momenteel de extensie in de templates naar .webp.
            </p>
          </div>
        </div>
      </div>

      {# AI Frontend #}
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> AI Frontend
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseAiFrontend" aria-expanded="false" aria-controls="collapseAiFrontend">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseAiFrontend">
        <div class="form-group col-xs-12">
          <p class="help-block">
            De zoekfunctie doorzoekt de gecontroleerde catalogusexport. De koppeling met OpenAI en de
            gebruiksregistratie worden nog aangesloten. Het opslaan van een API-sleutel activeert deze koppeling niet.
            Antwoorden worden altijd in het Nederlands getoond.
          </p>
        </div>
        {% if ai_tool_keys_allowed %}
          {% if not ai_tool_keys_shop_allowed %}
            <div class="alert alert-info col-xs-12">
              Selecteer bovenaan een afzonderlijke winkel waarvoor u toegang heeft om de API-sleutels in te stellen.
            </div>
          {% endif %}
          {% if ai_tool_keys_shop_allowed %}
            <input type="hidden" name="ai_tool_keys_token" value="{{ ai_tool_keys_token }}">
          {% endif %}
          {% for field in ai_tool_key_fields %}
            <div class="form-group col-xs-12">
              <label class="control-label col-xs-4 text-right" for="{{ field.name }}">
                OpenAI API-sleutel: {{ field.label }}
              </label>
              <div class="col-xs-8">
                <input type="password" name="{{ field.name }}" id="{{ field.name }}" value=""
                       class="form-control" autocomplete="new-password" maxlength="2048" spellcheck="false"
                       {% if not ai_tool_keys_shop_allowed %}disabled{% endif %}>
                <p class="help-block">
                  {% if field.configured %}Sleutel opgeslagen voor deze winkel. Laat leeg om deze te behouden.
                  {% else %}Nog geen sleutel opgeslagen voor deze winkel.{% endif %}
                </p>
                {% if field.configured %}
                  <label><input type="checkbox" name="{{ field.name }}_REMOVE" value="1"> Opgeslagen sleutel verwijderen</label>
                {% endif %}
              </div>
            </div>
          {% endfor %}
          <div class="form-group col-xs-12">
            <p class="help-block">
              Gebruik voor elke tool een eigen API-sleutel en klik onderaan op Opslaan. De sleutels worden alleen
              op de server bewaard, per winkel en voor alle talen. Dit staat los van de sleutel voor AI-productbeschrijvingen.
            </p>
          </div>
        {% endif %}
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4 text-right">
            AI in frontend inschakelen
          </label>
          <div class="col-xs-8">
            <div class="radio">
              <label><input type="radio" name="MSTHEMECONFIG_AI_FRONTEND_ENABLED" id="MSTHEMECONFIG_AI_FRONTEND_ENABLED_YES"
                            value="1"
                            {% if MSTHEMECONFIG_AI_FRONTEND_ENABLED == 1 %}checked="checked"{% endif %}>Ja</label>
            </div>
            <div class="radio">
              <label><input type="radio" name="MSTHEMECONFIG_AI_FRONTEND_ENABLED" id="MSTHEMECONFIG_AI_FRONTEND_ENABLED_NO"
                            value="0"
                            {% if MSTHEMECONFIG_AI_FRONTEND_ENABLED == 0 %}checked="checked"{% endif %}>Nee</label>
            </div>
            <p class="help-block">
              Zet AI aan voor de frontend. Extra context velden worden zichtbaar wanneer dit is ingeschakeld.
            </p>
          </div>
        </div>

        <div class="js-ai-frontend-context">
          <div class="form-group col-xs-12">
            <label class="control-label col-xs-4 text-right">
              Context voor zoeken
            </label>
            <div class="col-xs-8">
              <textarea name="MSTHEMECONFIG_AI_CONTEXT_SEARCH" id="MSTHEMECONFIG_AI_CONTEXT_SEARCH"
                        class="form-control" rows="3">{{ MSTHEMECONFIG_AI_CONTEXT_SEARCH }}</textarea>
              <p class="help-block">
                Voeg context toe voor AI-zoekopdrachten in de frontend.
              </p>
            </div>
          </div>

          <div class="form-group col-xs-12">
            <label class="control-label col-xs-4 text-right">
              Context voor plaat snedes
            </label>
            <div class="col-xs-8">
              <textarea name="MSTHEMECONFIG_AI_CONTEXT_PLATE_CUTS" id="MSTHEMECONFIG_AI_CONTEXT_PLATE_CUTS"
                        class="form-control" rows="3">{{ MSTHEMECONFIG_AI_CONTEXT_PLATE_CUTS }}</textarea>
              <p class="help-block">
                Voeg context toe voor plaat snedes.
              </p>
            </div>
          </div>

          <div class="form-group col-xs-12">
            <label class="control-label col-xs-4 text-right">
              Context voor zaag snedes
            </label>
            <div class="col-xs-8">
              <textarea name="MSTHEMECONFIG_AI_CONTEXT_SAW_CUTS" id="MSTHEMECONFIG_AI_CONTEXT_SAW_CUTS"
                        class="form-control" rows="3">{{ MSTHEMECONFIG_AI_CONTEXT_SAW_CUTS }}</textarea>
              <p class="help-block">
                Voeg context toe voor zaag snedes.
              </p>
            </div>
          </div>
        </div>
      </div>

      <script>
        (function () {
          var toggleInputs = document.querySelectorAll('input[name="MSTHEMECONFIG_AI_FRONTEND_ENABLED"]');
          var contextBlocks = document.querySelectorAll('.js-ai-frontend-context');

          function isEnabled() {
            var selected = document.querySelector('input[name="MSTHEMECONFIG_AI_FRONTEND_ENABLED"]:checked');
            return selected && selected.value === '1';
          }

          function updateVisibility() {
            var show = isEnabled();
            contextBlocks.forEach(function (block) {
              block.style.display = show ? '' : 'none';
            });
          }

          toggleInputs.forEach(function (input) {
            input.addEventListener('change', updateVisibility);
          });

          updateVisibility();
        })();
      </script>

  </div>
</div>
