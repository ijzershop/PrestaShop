<div class="card">
  <div class="card-header">
    Balie Checkout Instellingen
  </div>
  <div class="card-body">

    {# Delivery options #}
    <span class="col-xs-12 card-sub-header"><i class="star">*</i> Bezorging
      <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
              data-target="#collapseCounterDelivery" aria-expanded="false" aria-controls="collapseCounterDelivery">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
    </span>
    <div class="collapse" id="collapseCounterDelivery">
      <div class="form-group col-xs-12">
        <label class="control-label col-xs-4 text-right required">
          Toegestane verzendmethoden
        </label>
        <div class="col-xs-8">
          <select name="MSTHEMECONFIG_COUNTER_CARRIER_REFS[]"
                  class="w-100 form-control select2-data-input" data-type="carriers"
                  id="MSTHEMECONFIG_COUNTER_CARRIER_REFS" multiple="multiple" size="8">
            {{ MSTHEMECONFIG_COUNTER_CARRIER_REFS|raw }}
          </select>
          <p class="help-block">Selecteer de verzendmethoden die beschikbaar zijn voor balie klanten. Opgeslagen op basis van <code>id_reference</code>.</p>
        </div>
      </div>
      <div class="form-group col-xs-12">
        <label class="control-label col-xs-4 text-right required">
          Standaard verzendmethode
        </label>
        <div class="col-xs-8">
          <select name="MSTHEMECONFIG_COUNTER_DEFAULT_CARRIER_REF"
                  class="w-100 form-control select2-data-input" data-type="carriers"
                  id="MSTHEMECONFIG_COUNTER_DEFAULT_CARRIER_REF">
            {{ MSTHEMECONFIG_COUNTER_DEFAULT_CARRIER_REF|raw }}
          </select>
          <p class="help-block">De verzendmethode die automatisch wordt geselecteerd voor balie klanten. Opgeslagen als <code>id_reference</code>.</p>
        </div>
      </div>
    </div>

    {# Payment options #}
    <span class="col-xs-12 card-sub-header"><i class="star">*</i> Betaling
      <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
              data-target="#collapseCounterPayment" aria-expanded="false" aria-controls="collapseCounterPayment">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
    </span>
    <div class="collapse" id="collapseCounterPayment">
      <div class="form-group col-xs-12">
        <label class="control-label col-xs-4 text-right required">
          Toegestane betaalmethoden
        </label>
        <div class="col-xs-8">
          <select name="MSTHEMECONFIG_COUNTER_PAYMENT_MODULES[]"
                  class="w-100 form-control select2-data-input" data-type="payment_modules"
                  id="MSTHEMECONFIG_COUNTER_PAYMENT_MODULES" multiple="multiple" size="8">
            {{ MSTHEMECONFIG_COUNTER_PAYMENT_MODULES|raw }}
          </select>
          <p class="help-block">Selecteer de betaalmodules die beschikbaar zijn voor balie klanten (bijv. <code>ps_creditpayment</code>, <code>bankwire</code>).</p>
        </div>
      </div>
      <div class="form-group col-xs-12">
        <label class="control-label col-xs-4 text-right required">
          Standaard betaalmethode
        </label>
        <div class="col-xs-8">
          <select name="MSTHEMECONFIG_COUNTER_DEFAULT_PAYMENT"
                  class="w-100 form-control select2-data-input" data-type="payment_modules"
                  id="MSTHEMECONFIG_COUNTER_DEFAULT_PAYMENT">
            {{ MSTHEMECONFIG_COUNTER_DEFAULT_PAYMENT|raw }}
          </select>
          <p class="help-block">De betaalmodule die automatisch wordt voorgeselecteerd voor balie klanten.</p>
        </div>
      </div>
    </div>

  </div>
</div>
