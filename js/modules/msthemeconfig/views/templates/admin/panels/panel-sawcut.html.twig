<div class="card">
  <div class="card-header">
    Zagen & Knippen
  </div>
  <div class="card-body">

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Standaard zaagverlies (mm)</label>
      <div class="col-xs-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-ruler"></i></span>
          <input type="number" name="SAWANDCUT_DEFAULT_SAWLOSS" id="SAWANDCUT_DEFAULT_SAWLOSS" value="{{ SAWANDCUT_DEFAULT_SAWLOSS|default('0') }}" class="form-control" min="0" step="1">
        </div>
        <p class="help-block">Standaard zaagverlies per zaagsnede in millimeters</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Min. zaagmaat (mm)</label>
      <div class="col-xs-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-ruler"></i></span>
          <input type="number" name="SAWANDCUT_DEFAULT_MINSAWSIZE" id="SAWANDCUT_DEFAULT_MINSAWSIZE" value="{{ SAWANDCUT_DEFAULT_MINSAWSIZE|default('0') }}" class="form-control" min="0" step="1">
        </div>
        <p class="help-block">Minimale toegestane lengte per zaagsnede</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Min. knipmaat (mm)</label>
      <div class="col-xs-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-ruler"></i></span>
          <input type="number" name="SAWANDCUT_DEFAULT_MINCUTSIZE" id="SAWANDCUT_DEFAULT_MINCUTSIZE" value="{{ SAWANDCUT_DEFAULT_MINCUTSIZE|default('0') }}" class="form-control" min="0" step="1">
        </div>
        <p class="help-block">Minimale toegestane afmeting voor knippen (A/B)</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Min. restknip (mm)</label>
      <div class="col-xs-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-ruler"></i></span>
          <input type="number" name="SAWANDCUT_DEFAULT_MINCUTREMAINDER" id="SAWANDCUT_DEFAULT_MINCUTREMAINDER" value="{{ SAWANDCUT_DEFAULT_MINCUTREMAINDER|default('0') }}" class="form-control" min="0" step="1">
        </div>
        <p class="help-block">Minimale toegestane restmaat na knippen</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Standaard knipprijs</label>
      <div class="col-xs-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-euro"></i></span>
          <input type="number" name="SAWANDCUT_DEFAULT_CUT_PRICE" id="SAWANDCUT_DEFAULT_CUT_PRICE" value="{{ SAWANDCUT_DEFAULT_CUT_PRICE|default('0') }}" class="form-control" min="0" step="0.01">
        </div>
        <p class="help-block">Standaard prijs per knip handeling</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Eenvoudig knipformulier</label>
      <div class="col-xs-8">
        <input type="hidden" name="SAWANDCUT_SINGLE_CUT_ENABLED" value="0">
        <label class="custom-control custom-switch mb-0">
          <input
            type="checkbox"
            class="custom-control-input"
            id="SAWANDCUT_SINGLE_CUT_ENABLED"
            name="SAWANDCUT_SINGLE_CUT_ENABLED"
            value="1"
            {% if SAWANDCUT_SINGLE_CUT_ENABLED|default('0') == '1' %}checked{% endif %}
          >
          <span class="custom-control-label">Inschakelen</span>
        </label>
        <p class="help-block">Toon het eenvoudige knipformulier (alleen breedte/hoogte)</p>
      </div>
    </div>

    <hr>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Attribuut groep (zagen)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_ATTRIBUTE_GROUP" class="w-100 select2-data-input" data-type="attribute_groups" id="SAWANDCUT_ATTRIBUTE_GROUP">
          {{ SAWANDCUT_ATTRIBUTE_GROUP|raw }}
        </select>
        <p class="help-block">Koppel de attribuutgroep met zaagsnedes</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Attribuut groep (knippen)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_ATTRIBUTE_GROUP_CUT" class="w-100 select2-data-input" data-type="attribute_groups" id="SAWANDCUT_ATTRIBUTE_GROUP_CUT">
          {{ SAWANDCUT_ATTRIBUTE_GROUP_CUT|raw }}
        </select>
        <p class="help-block">Koppel de attribuutgroep met knip combinaties</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Feature: Lengte (zaag)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_FEATURE_LENGTH" class="w-100 select2-data-input" data-type="features" id="SAWANDCUT_FEATURE_LENGTH">
          {{ SAWANDCUT_FEATURE_LENGTH|raw }}
        </select>
        <p class="help-block">Koppel het product kenmerk dat de totale productlengte bevat</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Feature: Lengte (knip)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_FEATURE_CUTLENGTH" class="w-100 select2-data-input" data-type="features" id="SAWANDCUT_FEATURE_CUTLENGTH">
          {{ SAWANDCUT_FEATURE_CUTLENGTH|raw }}
        </select>
        <p class="help-block">Koppel het product kenmerk voor plaatlengte (A)</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Feature: Breedte (knip)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_FEATURE_CUTWIDTH" class="w-100 select2-data-input" data-type="features" id="SAWANDCUT_FEATURE_CUTWIDTH">
          {{ SAWANDCUT_FEATURE_CUTWIDTH|raw }}
        </select>
        <p class="help-block">Koppel het product kenmerk voor plaatbreedte (B)</p>
      </div>
    </div>

    <hr>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Offerte pagina</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_OFFER_PAGE" class="w-100 select2-data-input" data-type="pages" id="SAWANDCUT_OFFER_PAGE">
          {{ SAWANDCUT_OFFER_PAGE|raw }}
        </select>
        <p class="help-block">Pagina voor vrijblijvende offerte aanvraag</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Info pagina (zagen)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_SAWINFO_PAGE" class="w-100 select2-data-input" data-type="pages" id="SAWANDCUT_SAWINFO_PAGE">
          {{ SAWANDCUT_SAWINFO_PAGE|raw }}
        </select>
        <p class="help-block">CMS pagina met uitleg over het zaagformulier</p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 text-right">Info pagina (knippen)</label>
      <div class="col-xs-8">
        <select name="SAWANDCUT_CUTINFO_PAGE" class="w-100 select2-data-input" data-type="pages" id="SAWANDCUT_CUTINFO_PAGE">
          {{ SAWANDCUT_CUTINFO_PAGE|raw }}
        </select>
        <p class="help-block">CMS pagina met uitleg over het knipformulier</p>
      </div>
    </div>

  </div>
</div>
