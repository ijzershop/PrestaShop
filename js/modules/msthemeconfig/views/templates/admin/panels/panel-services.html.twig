<div class="card">
  <div class="card-header">
    {{ "Services & Api's"|trans({}, 'Modules.MsThemeConfig.Admin') }}
  </div>
  <div class="card-body">

      <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'Google Maps'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseGoogle" aria-expanded="false" aria-controls="collapseGoogle">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseGoogle">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4">
            {{ 'Google maps api key'|trans({}, 'Modules.MsThemeConfig.Admin') }}
          </label>
          <div class="col-lg-8">
            <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-key"></i>
                  </span>
              <input type="text" name="MSTHEMECONFIG_MAPS_KEY" id="MSTHEMECONFIG_MAPS_KEY"
                     value="{{ MSTHEMECONFIG_MAPS_KEY }}" class="form-control">
            </div>
            <p class="help-block">
              {{ 'Enter your google maps key'|trans({}, 'Modules.MsThemeConfig.Admin') }}
            </p>
          </div>
        </div>
      </div>
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'Clarity'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseClarity" aria-expanded="false" aria-controls="collapseClarity">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseClarity">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4">
            {{ 'Clarity ID'|trans({}, 'Modules.MsThemeConfig.Admin') }}
          </label>
          <div class="col-lg-8">
            <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-key"></i>
                  </span>
              <input type="text" name="MSTHEMECONFIG_CLARITY_ID"
                     id="MSTHEMECONFIG_CLARITY_ID" value="{{ MSTHEMECONFIG_CLARITY_ID }}"
                     class="form-control">
            </div>
            <p class="help-block">
              {{ 'Enter your clarity id'|trans({}, 'Modules.MsThemeConfig.Admin') }}
            </p>
          </div>
        </div>
      </div>
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'TawkTo Chat'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseTawkTo" aria-expanded="false" aria-controls="collapseTawkTo">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseTawkTo">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4">
            {{ 'Tawk'|trans({}, 'Modules.MsThemeConfig.Admin') }}
          </label>
          <div class="col-lg-8">
            <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-key"></i>
                  </span>
              <input type="text" name="MSTHEMECONFIG_TAWKTO_WIDGET_ID"
                     id="MSTHEMECONFIG_TAWKTO_WIDGET_ID"
                     value="{{ MSTHEMECONFIG_TAWKTO_WIDGET_ID }}" class="form-control">
            </div>
            <p class="help-block">
              {{ 'Enter your Tawk.to Widget ID'|trans({}, 'Modules.MsThemeConfig.Admin') }}
            </p>
          </div>
        </div>
      </div>
      <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'Trello Api'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseTrello" aria-expanded="false" aria-controls="collapseTrello">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
      <div class="collapse" id="collapseTrello">
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4">
            {{ 'Trello Url'|trans({}, 'Modules.MsThemeConfig.Admin') }}
          </label>
          <div class="col-lg-8">
            <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-trello"></i>
                  </span>
              <input type="text" name="MSTHEMECONFIG_TRELLO_URL"
                     id="MSTHEMECONFIG_TRELLO_URL" value="{{ MSTHEMECONFIG_TRELLO_URL }}"
                     class="form-control">
            </div>
            <p class="help-block">
              {{ 'Trello url'|trans({}, 'Modules.MsThemeConfig.Admin') }}
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4">
            {{ 'Trello secret'|trans({}, 'Modules.MsThemeConfig.Admin') }}
          </label>
          <div class="col-lg-8">
            <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-key"></i>
                  </span>
              <input type="text" name="MSTHEMECONFIG_TRELLO_SECRET"
                     id="MSTHEMECONFIG_TRELLO_SECRET"
                     value="{{ MSTHEMECONFIG_TRELLO_SECRET }}" class="form-control">
            </div>
            <p class="help-block">
              {{ 'The trello secret'|trans({}, 'Modules.MsThemeConfig.Admin') }}
            </p>
          </div>
        </div>
        <div class="form-group col-xs-12">
          <label class="control-label col-xs-4">
            {{ 'Trello Token'|trans({}, 'Modules.MsThemeConfig.Admin') }}
          </label>
          <div class="col-lg-8">
            <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-key"></i>
                  </span>
              <input type="text" name="MSTHEMECONFIG_TRELLO_TOKEN"
                     id="MSTHEMECONFIG_TRELLO_TOKEN"
                     value="{{ MSTHEMECONFIG_TRELLO_TOKEN }}" class="form-control">
            </div>
            <p class="help-block">
              {{ 'The trello token'|trans({}, 'Modules.MsThemeConfig.Admin') }}
            </p>
          </div>
        </div>
      </div>
  </div>
  <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'Modernesmid Dashboard'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseDashboard" aria-expanded="false" aria-controls="collapseDashboard">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
  <div class="collapse" id="collapseDashboard">
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4 required">
        {{ 'Url of the api domain'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-xs-8">
        <input type="text" name="MSTHEMECONFIG_DASHBOARD_API_URL"
               id="MSTHEMECONFIG_DASHBOARD_API_URL"
               value="{{ MSTHEMECONFIG_DASHBOARD_API_URL }}" class="form-control">
        <p class="help-block">
          {{ 'Insert here the domain of the dahsboard api'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12" data-tab-id="dashboard_api">
      <label class="control-label col-xs-4 required">
        {{ 'The username of the api'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-xs-8">
        <input type="text" name="MSTHEMECONFIG_DASHBOARD_API_USER"
               id="MSTHEMECONFIG_DASHBOARD_API_USER"
               value="{{ MSTHEMECONFIG_DASHBOARD_API_USER }}" class="form-control">
        <p class="help-block">
          {{ 'Insert here the username of the dahsboard api'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12" data-tab-id="dashboard_api">
      <label class="control-label col-xs-4 required">
        {{ 'The Password of the api'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-xs-8">
        <div class="input-group">
                  <span class="input-group-addon">
                  <i class="icon-key"></i>
                  </span>
          <input type="password" id="MSTHEMECONFIG_DASHBOARD_API_PASS"
                 name="MSTHEMECONFIG_DASHBOARD_API_PASS" class="form-control"
                 value="{{ MSTHEMECONFIG_DASHBOARD_API_PASS }}">
        </div>
        <p class="help-block">
          {{ 'Insert here the password of the dahsboard api'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
  </div>
  <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'Google Analytics 4 (Measurement Protocol)'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseGA4" aria-expanded="false" aria-controls="collapseGA4">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
  <div class="collapse" id="collapseGA4">
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'Measurement ID'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-key"></i></span>
          <input type="text" name="MSTHEMECONFIG_GA4_MEASUREMENT_ID" id="MSTHEMECONFIG_GA4_MEASUREMENT_ID"
                 value="{{ MSTHEMECONFIG_GA4_MEASUREMENT_ID }}" class="form-control"
                 placeholder="G-XXXXXXXXXX">
        </div>
        <p class="help-block">
          {{ 'GA4 Measurement ID from Google Analytics (Data Streams)'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'API Secret'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <div class="input-group">
          <span class="input-group-addon"><i class="icon-key"></i></span>
          <input type="password" name="MSTHEMECONFIG_GA4_API_SECRET" id="MSTHEMECONFIG_GA4_API_SECRET"
                 value="{{ MSTHEMECONFIG_GA4_API_SECRET }}" class="form-control">
        </div>
        <p class="help-block">
          {{ 'Measurement Protocol API Secret from GA4 Admin → Data Streams → your stream → Measurement Protocol API secrets'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'Trigger order states'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <select name="MSTHEMECONFIG_GA4_TRIGGER_STATES[]" class="w-100 select2-data-input"
                data-type="order_states"
                id="MSTHEMECONFIG_GA4_TRIGGER_STATES" multiple="multiple" size="8">
          {{ MSTHEMECONFIG_GA4_TRIGGER_STATES|raw }}
        </select>
        <p class="help-block">
          {{ 'Select the order states that trigger a server-side GA4 purchase event. Typically "Payment accepted" (state 2).'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'Geannuleerde order states'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <select name="MSTHEMECONFIG_GA4_CANCEL_STATES[]" class="w-100 select2-data-input"
                data-type="order_states"
                id="MSTHEMECONFIG_GA4_CANCEL_STATES" multiple="multiple" size="8">
          {{ MSTHEMECONFIG_GA4_CANCEL_STATES|raw }}
        </select>
        <p class="help-block">
          {{ 'Selecteer de order statussen die een GA4 canceled event versturen (server-side). Typisch "Geannuleerd" of vergelijkbare annuleer-status.'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'Measurement Protocol endpoint'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <input type="text" name="MSTHEMECONFIG_GA4_ENDPOINT" id="MSTHEMECONFIG_GA4_ENDPOINT"
               value="{{ MSTHEMECONFIG_GA4_ENDPOINT }}" class="form-control"
               placeholder="https://sst.example.com/mp/collect">
        <p class="help-block">
          {{ 'Per-shop URL to POST purchase events to. Use that shop\'s TAGGRS domain (e.g. https://sst.example.com/mp/collect) to route through GTM server-side, or https://www.google-analytics.com/mp/collect to go directly to GA4.'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'GTM tagging-server URL'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <input type="url" name="MSTHEMECONFIG_GTM_SERVER_URL" id="MSTHEMECONFIG_GTM_SERVER_URL"
               value="{{ MSTHEMECONFIG_GTM_SERVER_URL }}" class="form-control"
               placeholder="https://sst.example.com">
        <p class="help-block">
          {{ 'Per-shop TAGGRS hostname used to load the web GTM container. Enter only the origin, without /gtm.js or /mp/collect. When empty, the module derives it from a non-Google Measurement Protocol endpoint and otherwise uses www.googletagmanager.com.'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'Betaling analytics logging'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <div class="radio">
          <label><input type="radio" name="MSTHEMECONFIG_GA4_PAYMENT_LOG" id="MSTHEMECONFIG_GA4_PAYMENT_LOG_YES"
                        value="1"
                        {% if MSTHEMECONFIG_GA4_PAYMENT_LOG == 1 %}checked="checked"{% endif %}>Aan</label>
        </div>
        <div class="radio">
          <label><input type="radio" name="MSTHEMECONFIG_GA4_PAYMENT_LOG" id="MSTHEMECONFIG_GA4_PAYMENT_LOG_NO"
                        value="0"
                        {% if MSTHEMECONFIG_GA4_PAYMENT_LOG != 1 %}checked="checked"{% endif %}>Uit</label>
        </div>
        <p class="help-block">
          {{ 'Schrijft de volledige betalingsflow (server-side GA4 en order-confirmation) naar var/logs/payment_analytics.log. Alleen inschakelen tijdens debuggen — zet daarna weer uit.'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>

    <div class="form-group col-xs-12">
      <label class="control-label col-xs-4">
        {{ 'Analytics event logging (browser)'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-lg-8">
        <div class="radio">
          <label><input type="radio" name="MSTHEMECONFIG_GA4_EVENT_LOG" id="MSTHEMECONFIG_GA4_EVENT_LOG_YES"
                        value="1"
                        {% if MSTHEMECONFIG_GA4_EVENT_LOG == 1 %}checked="checked"{% endif %}>Aan</label>
        </div>
        <div class="radio">
          <label><input type="radio" name="MSTHEMECONFIG_GA4_EVENT_LOG" id="MSTHEMECONFIG_GA4_EVENT_LOG_NO"
                        value="0"
                        {% if MSTHEMECONFIG_GA4_EVENT_LOG != 1 %}checked="checked"{% endif %}>Uit</label>
        </div>
        <p class="help-block">
          {{ 'Logt alle browser analytics events (offer_btn, switch_img, add_to_cart, etc.) naar var/logs/analytics_events.log via sendBeacon. Elke regel is JSON met timestamp, event naam, pagina en cart_id. Alleen inschakelen tijdens debuggen.'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        </p>
      </div>
    </div>
  </div>
  <span class="col-xs-12 card-sub-header"><i class="star">*</i> {{ 'Channable'|trans({}, 'Modules.MsThemeConfig.Admin') }}
        <button class="btn btn-sm btn-link pull-right collapsed" type="button" data-toggle="collapse"
                data-target="#collapseChannable" aria-expanded="false" aria-controls="collapseChannable">
        <i class="toggle-panel text-white text-decoration-none"></i>
      </button>
      </span>
  <div class="collapse" id="collapseChannable">
    <div class="form-group col-xs-12" data-tab-id="channable">
      <label class="control-label col-xs-4 required">
        {{ 'Enabled Channable Categories'|trans({}, 'Modules.MsThemeConfig.Admin') }}
      </label>
      <div class="col-xs-8">
        <select name="MSTHEMECONFIG_CHANNABLE_CATEGORIES[]" class="w-100 select2-data-input"
                data-type="categories_home"
                id="MSTHEMECONFIG_CHANNABLE_CATEGORIES" multiple="multiple" size="15">
          {{ MSTHEMECONFIG_CHANNABLE_CATEGORIES|raw }}
        </select>
        <p class="help-block">
          Select all categories you would like to send to the channable feed<br/>
          To clear the field paste the string below in the console of your webbrowser
          Paste:  $('#MSTHEMECONFIG_CHANNABLE_CATEGORIES').val("").trigger("change.select2");
        </p>
      </div>
    </div>
  </div>
  </form>
</div>
</div>

