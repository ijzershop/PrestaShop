{% extends '@MailThemes/modernesmid/components/layout.html.twig' %}

{% block title %}{{ 'Account'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}



  {#       Start Blue Block         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="Margin:0;padding-bottom:10px;padding-top:10px;padding-right:30px;padding-left:30px;background-color:#ffffff" data-custom-paddings="true">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="center" valign="top" style="padding:0;Margin:0;width:540px">
            <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="left" bgcolor="#4472c4" class="es-text-7647" style="padding:0;Margin:0;padding-top:20px;padding-bottom:10px"><h1 class="es-text-mobile-size-20" style="Margin:0;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;mso-line-height-rule:exactly;letter-spacing:0;font-size:20px;font-style:normal;font-weight:bold;line-height:24px;color:#ffffff;text-align:center"><b>Hier zijn uw aanmeldgegevens</b></h1></td>
              </tr>
              <tr>
                <td align="center" bgcolor="#4472c4" style="padding:0;Margin:0;padding-right:20px;padding-left:20px;padding-bottom:20px"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">E-mailadres: {email}</p></td>
              </tr>
            </table></td>
        </tr>
      </table></td>
  </tr>
  {#       Start Blue Block         #}

  {#       Start White Block         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-right:30px;padding-left:30px;padding-bottom:10px;background-color:#ffffff">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="left" style="padding:0;Margin:0;width:560px">
            <table cellspacing="0" width="100%" role="presentation" cellpadding="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="center" class="es-text-7117" style="padding:0;Margin:0;padding-bottom:10px;padding-top:10px"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left"><b>Belangrijke veiligheidstips</b></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left">
                  <ul style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left">
                    <li>Bewaar uw accountgegevens op een veilige plaats.</li>
                    <li>Verstrek uw aanmeldgegevens nooit aan derden.</li>
                    <li>Wijzig uw wachtwoord regelmatig.</li>
                    <li>Als u vermoedt dat iemand anders uw account zonder uw toestemming gebruikt, neem dan onmiddellijk contact met ons op.
                    </li>
                  </ul>
                  </p>
                </td>
              </tr>
            </table></td>
        </tr>
      </table></td>
  </tr>
  {#       End white Block         #}

{% endblock %}


{% block footer_blocks %}

  <tr>
    <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-bottom:10px;background-color:#ffffff">
                {{ footer_blocks|raw }}
    </td>
  </tr>


{% endblock %}
