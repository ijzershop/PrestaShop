{% extends '@MailThemes/modernesmid/components/layout.html.twig' %}

{% block title %}{{ 'Pickup'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}
  {#       Start White Block         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-right:30px;padding-left:30px;padding-bottom:10px;background-color:#ffffff">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="left" style="padding:0;Margin:0;width:560px">
            <table cellspacing="0" width="100%" role="presentation" cellpadding="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="center" class="es-text-3853" style="padding:0;Margin:0;padding-bottom:10px;padding-top:10px"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left"><b>Beste Tako,</b></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left">Wij hebben uw bestelling voor uw klaargezet om af te halen!</p></td>
              </tr>
            </table></td>
        </tr>
      </table></td>
  </tr>
  {#       End white Block         #}




  {#       Start Blue Block NO-HEADER         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="Margin:0;padding-bottom:10px;padding-top:10px;padding-right:30px;padding-left:30px;background-color:#ffffff" data-custom-paddings="true">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="center" valign="top" style="padding:0;Margin:0;">
            <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="left" bgcolor="#4472c4" class="es-text-5318" style="padding:0;Margin:0;padding-top:20px;padding-bottom:10px"><h1 class="es-text-mobile-size-20" style="Margin:0;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;mso-line-height-rule:exactly;letter-spacing:0;font-size:20px;font-style:normal;font-weight:bold;line-height:24px;color:#ffffff;text-align:center"><b> Haal uw bestelling op</b></h1></td>
              </tr>
              <tr>
                <td align="center" bgcolor="#4472c4" style="padding:0;Margin:0;padding-right:20px;padding-left:20px;padding-bottom:20px"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px"><b></b>Uw bestelling ligt klaar op</p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px"><b>Ceresweg 1 te Leeuwarden</b></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px"><br></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">U kan direct uw bestelling afhalen in Leeuwarden. Op vertoon van deze e-mail zal de bestelling aan u worden meegegeven.</p>


                  <p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">
                  <ul style="list-style-type: none;padding:0px;Margin:0;margin-top:20px;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">
                    <li><strong>Referentie {order_name}</strong></li>
                    <li><strong>Besteld door {firstname} {lastname}</strong></li>
                  </ul>

                  </p></td>
              </tr>


      </table>
          </td>
  </tr>
      </table>
    </td>
    </tr>
  {#       Start Blue Block         #}
        {#       Start White Block         #}
        <tr>
