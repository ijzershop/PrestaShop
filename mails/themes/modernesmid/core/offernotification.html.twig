{% extends '@MailThemes/modernesmid/components/layout.html.twig' %}

{% block title %}{{ 'Your offer'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}
{#       Start White Block         #}
<tr>
  <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-right:30px;padding-left:30px;padding-bottom:10px;background-color:#ffffff">
    <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
      <tr>
        <td align="left" style="padding:0;Margin:0;width:560px">
          <table cellspacing="0" width="100%" role="presentation" cellpadding="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
            <tr>
              <td align="center" class="es-text-7117" style="padding:0;Margin:0;padding-bottom:10px;padding-top:10px">
                <p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left">
                  Bekijk de door u aangevraagde offerte via de onderstaande link:
                </p>
              </td>
            </tr>
          </table></td>
      </tr>
    </table></td>
</tr>
{#       End white Block         #}


{#       Start Blue Block NO-HEADER         #}
<tr>
  <td align="left" bgcolor="#ffffff" style="Margin:0;padding-bottom:10px;padding-top:10px;padding-right:30px;padding-left:30px;background-color:#ffffff" data-custom-paddings="true">
    <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
      <tr>
        <td align="center" valign="top" style="padding:0;Margin:0;width:540px">
          <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
            <tr>
              <td align="center" bgcolor="#4472c4" style="padding:0;Margin:0;padding-top:20px;padding-right:20px;padding-left:20px;padding-bottom:20px">
                <p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">
                  {url}
                </p>
              </td>
            </tr>
            <tr>
              <td align="left" bgcolor="#4472c4" style="padding:0;Margin:0;padding-top:20px;padding-right:20px;padding-left:20px;padding-bottom:20px">
                <p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">
                <ul style="font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px;margin:0px 0px 0px 20px;margin-block-start:0px;margin-block-end:0px;padding-inline-start:0px;" type="square">
                  <li>offerte pagina word geopend op <a color="#ffffff !important;text-decoration:none;" style="color:#ffffff;text-decoration:none;font-weight:500;display: inline-block;" href="{shop_url}"><strong><font color="#FFFFFF">{shop_url}</font></strong></a></li>
                  <li>vul hier uw email: <a color="#ffffff !important;text-decoration:none;" style="color:#ffffff;text-decoration:none;font-weight:500;display: inline-block;" href="mailto:{customer_email}"><strong><font color="#FFFFFF">{customer_email}</font></strong></a> en de code: <strong class="label link-white" style="color:#ffffff;text-decoration:none;font-weight: 600;">{offer_access_code}</strong> in</li>
                  <li>als beide correct zijn ingevuld klikt u op "Toon mijn offerte"</li>
                  <li>vul het gewenste aantal in</li>
                  <li>plaats in uw winkelwagen</li>
                  <li>voeg eventueel extra producten toe</li>
                  <li>bestel & betaal</li>
                </ul>
                </p>
              </td>
            </tr>
            <tr>
              <td align="center" bgcolor="#4472c4" style="padding:0;Margin:0;padding-top:20px;padding-right:20px;padding-left:20px;padding-bottom:20px">
                <p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">
                  Let op! Deze aanbieding verloopt op <span class="label" style="font-weight: 700;">{date_exp_exact}</span>,
                  daarna wordt de aanbieding verwijderd uit ons systeem.
                </p>
              </td>
            </tr>
          </table></td>
      </tr>
    </table></td>
</tr>
{#       Start Blue Block         #}
      {% endblock %}

{% block footer_blocks %}
  <tr>
    <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-bottom:10px;background-color:#ffffff">
      {{ footer_blocks|raw }}
    </td>
  </tr>
{% endblock %}

      {% block styles %}
        {{ parent() }}
        <style type="text/css">
          #outlook a {
            padding: 0;
          }

          .ReadMsgBody {
            width: 100%;
          }

          .ExternalClass {
            width: 100%;
          }

          .ExternalClass * {
            line-height: 25px;
          }

          body {
            margin: 0;
            padding: 0;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
          }

          table,
          td {
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
          }

          img {
            border: 0;
            height: auto;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
          }

          p {
            display: block;
            margin: 13px 0;
          }
        </style><style type="text/css">
        @media only screen and (max-width:480px) {
          @-ms-viewport {
            width: 320px;
          }

          @viewport {
            width: 320px;
          }
        }
      </style><style type="text/css">
        @import url(https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,700);
        @import url(https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i);
      </style><style type="text/css">
        @media only screen and (min-width:480px) {
          .mj-column-per-100 {
            width: 100% !important;
            max-width: 100%;
          }

          .mj-column-px-25 {
            width: 25px !important;
            max-width: 25px;
          }
        }
      </style><style type="text/css">
      </style><style type="text/css">
        .shadow {
          box-shadow: 0 20px 30px 0 rgba(0, 0, 0, 0.1);
        }

        .label {
          font-weight: 700;
        }

        .warning {
          font-weight: 700;
          font-size: 16px;
        }

        a {
          color: #3b56ad;
          text-decoration: underline;
          font-weight: 600;
        }

        a.light {
          font-weight: 400;
        }

        span.strong {
          font-weight: 600;
        }

        @media only screen and (max-width: 480px) {

          body,
          .no-bg {
            background-color: #fff !important;
          }

          .left p {
            text-align: left;
            display: inline-block
          }
        }
      </style>

      {% endblock %}
