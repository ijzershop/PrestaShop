{% extends '@MailThemes/modernesmid/components/layout.html.twig' %}

{% block title %}{{ 'Shipped'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}

  {#       Start White Block         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-right:30px;padding-left:30px;padding-bottom:10px;background-color:#ffffff">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="left" style="padding:0;Margin:0;width:560px">
            <table cellspacing="0" width="100%" role="presentation" cellpadding="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="center" class="es-text-7796" style="padding:0;Margin:0;padding-bottom:10px;padding-top:10px"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left"><b>Beste Tako,</b></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px;text-align:left">Uw bestelling is verzonden!</p></td>
              </tr>
            </table></td>
        </tr>
      </table></td>
  </tr>
  {#       End white Block         #}

  {#       Start Blue Block NO-HEADER         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="Margin:0;padding-bottom:10px;padding-top:10px;padding-right:30px;padding-left:30px;background-color:#ffffff" data-custom-paddings="true">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="center" valign="top" style="padding:0;Margin:0;width:540px">
            <table cellpadding="0" cellspacing="0" width="100%" role="presentation" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="left" bgcolor="#4472c4" class="es-text-3109" style="padding:0;Margin:0;padding-top:20px;padding-bottom:10px"><h1 class="es-text-mobile-size-20" style="Margin:0;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;mso-line-height-rule:exactly;letter-spacing:0;font-size:20px;font-style:normal;font-weight:bold;line-height:24px;color:#ffffff;text-align:center"><b> Volg uw bestelling via Track &amp; Trace</b></h1></td>
              </tr>
              <tr>
                <td align="center" bgcolor="#4472c4" style="padding:0;Margin:0;padding-right:20px;padding-left:20px;padding-bottom:5px"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#ffffff;font-size:16px">Uw pakket is klaargemaakt in onze fabriek en wordt snel opgehaald door de bezorger. Klik op onderstaande knop om te zien waar uw bestelling nu is.</p></td>
              </tr>
              <tr>
                <td align="center" bgcolor="#4472c4" style="padding:0;Margin:0;padding-right:20px;padding-left:20px;padding-bottom:20px"><span class="es-button-border es-fw es-button-border-4404" style="border-style:solid;border-color:#2CB543;background:#42d159;border-width:0px;display:block;border-radius:5px;width:auto"><a href="{tracking_url}" target="_blank" class="es-button es-button-5165" style="mso-style-priority:100 !important;text-decoration:none !important;mso-line-height-rule:exactly;color:#FFFFFF;font-size:16px;padding:10px 20px 10px 20px;display:block;background:#42d159;border-radius:5px;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;font-weight:normal;font-style:normal;line-height:19.2px;width:auto;text-align:center;letter-spacing:0;mso-padding-alt:0;mso-border-alt:10px solid #42d159">Volg uw pakket</a></span></td>
              </tr>
            </table></td>
        </tr>
      </table></td>
  </tr>
  {#       Start Blue Block         #}

  {#       Start White Block         #}
  <tr>
    <td align="left" bgcolor="#ffffff" style="padding:0;Margin:0;padding-top:20px;padding-right:50px;padding-left:50px;padding-bottom:10px;background-color:#ffffff">
      <table cellpadding="0" cellspacing="0" width="100%" role="none" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
        <tr>
          <td align="left" style="padding:0;Margin:0;">
            <table cellspacing="0" width="100%" role="presentation" cellpadding="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="left" style="padding:0;Margin:0;width:500px">
                  <table cellspacing="0" width="100%" role="presentation" cellpadding="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
                    <tr>
                      <td align="left" class="es-text-6593" style="padding:0;Margin:0"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px"><b>Wanneer krijg ik mijn bestelling?</b></p><h2 style="Margin:0;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;mso-line-height-rule:exactly;letter-spacing:0;font-size:24px;font-style:normal;font-weight:bold;line-height:28.8px;color:#212121"></h2></td>
                    </tr>
                    <tr>
                      <td align="left" style="padding:0;Margin:0"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px">De bestellingen worden dagelijks om 2 uur bij ons opgehaald en de bezorger levert doorgaans de volgende dag bij u thuis. De dag van levering kunt u zien via de Track &amp; Trace link.&nbsp;</p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px"><br></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#4472c4;font-size:16px"><strong><b><a target="_blank" href="{my_account_url}" style="mso-line-height-rule:exactly;text-decoration:none;color:#4472c4;font-size:16px">&gt; Bezoek uw klantenaccount voor de bestelstatus</a></b></strong></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#4472c4;font-size:16px"><strong><b><a href="{tracking_url}" target="_blank" style="mso-line-height-rule:exactly;text-decoration:none;color:#4472c4;font-size:16px">&gt; Volg uw bestelling via</a> Track &amp; Trace</b></strong></p></td>
                    </tr>
                  </table></td>
              </tr>
            </table></td>
        </tr>
        <tr>
          <td align="left" style="padding:0;Margin:0;width:500px;padding-top:20px;">
            <table width="100%" role="presentation" cellpadding="0" cellspacing="0" style="mso-table-lspace:0pt;mso-table-rspace:0pt;border-collapse:collapse;border-spacing:0px">
              <tr>
                <td align="left" class="es-text-6358" style="padding:0;Margin:0"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px"><b>Hoe laat krijg ik mijn bestelling?</b></p><h2 style="Margin:0;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;mso-line-height-rule:exactly;letter-spacing:0;font-size:24px;font-style:normal;font-weight:bold;line-height:28.8px;color:#212121"></h2></td>
              </tr>
              <tr>
                <td align="left" style="padding:0;Margin:0"><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px">Dit weten we pas op de ochtend dat het pakket wordt geleverd. Dit is dan te zien in de track en trace. U ontvangt op de dag van levering tussen 8 en 10 uur een Track &amp; Trace van de bezorger met een tijdvak van levering.</p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#131313;font-size:16px"><br></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#4472c4;font-size:16px"><strong><b><a target="_blank" href="{my_account_url}" style="mso-line-height-rule:exactly;text-decoration:none;color:#4472c4;font-size:16px">&gt; Bezoek uw klantenaccount voor de bestelstatus</a></b></strong></p><p style="Margin:0;mso-line-height-rule:exactly;font-family:roboto, 'helvetica neue', helvetica, arial, sans-serif;line-height:24px;letter-spacing:0;color:#4472c4;font-size:16px"><strong><b><a href="{tracking_url}" target="_blank" style="mso-line-height-rule:exactly;text-decoration:none;color:#4472c4;font-size:16px">&gt; Volg uw bestelling via Track & Trace</a></b></strong></p></td>
              </tr>
            </table></td>
        </tr>

      </table></td>
  </tr>
  {#       End white Block         #}

{% endblock %}

{% block footer_blocks %}

  {{ footer_blocks|raw }}

{% endblock %}
{% block styles %}
  {{ parent() }}
  <style type="text/css">
    #outlook a {
      padding: 0;
    }

    .ReadMsgBody {
      width: 100%;
    }

    .ExternalClass {
      width: 100%;
    }

    .ExternalClass * {
      line-height: 25px;
    }

    body {
      margin: 0;
      padding: 0;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }

    img {
      border: 0;
      height: auto;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }

    p {
      display: block;
      margin: 13px 0;
    }
  </style><style type="text/css">
  @media only screen and (max-width:480px) {
    @-ms-viewport {
      width: 320px;
    }

    @viewport {
      width: 320px;
    }
  }
</style><style type="text/css">
  @import url(https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,700);
  @import url(https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i,800,800i);
</style><style type="text/css">
  @media only screen and (min-width:480px) {
    .mj-column-per-100 {
      width: 100% !important;
      max-width: 100%;
    }

    .mj-column-px-25 {
      width: 25px !important;
      max-width: 25px;
    }
  }
</style><style type="text/css">
</style><style type="text/css">
  .shadow {
    box-shadow: 0 20px 30px 0 rgba(0, 0, 0, 0.1);
  }

  .label {
    font-weight: 700;
  }

  .warning {
    font-weight: 700;
    font-size: 16px;
  }

  a {
    color: #3b56ad;
    text-decoration: underline;
    font-weight: 600;
  }

  a.light {
    font-weight: 400;
  }

  span.strong {
    font-weight: 600;
  }

  @media only screen and (max-width: 480px) {

    body,
    .no-bg {
      background-color: #fff !important;
    }

    .left p {
      text-align: left;
      display: inline-block
    }
  }
</style>

{% endblock %}
