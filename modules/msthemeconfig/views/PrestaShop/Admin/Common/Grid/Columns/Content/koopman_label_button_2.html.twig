<style type="text/css">
.qty-weight-button{
  width: 52px;
  display: inline-block;
  height: 55px;
  line-height: 48px;
  font-size: 28px;
  border: transparent;
  background-size: cover;
  background-repeat: no-repeat;
  background-image: url('/upload/icon-weight.svg');
}

.qty-button {
  width: 52px;
  display: inline-block;
  height: 38px;
  line-height: 36px;
  font-size: 40px;
}

.collie-input{
  font-size: 24px;
  font-weight: bold;
}


.collie-type-footer{
  border-top: 1px solid black;
  padding: .9em;

}
.fancybox-close{
  position: fixed;
  top: 8px;
  right: 10px;
}

.fancybox-inner{
  overflow: inherit!important;
}

/* New */
.collie-nav .page-item .page-link {
  margin: 4px;
  z-index: 1;
  color: #fff;
  background-color: #ffffff!important;
  border-color: #007bff;
}

.collie-nav .page-item.active .page-link {
  z-index: 1;
  background-color: #007bff!important;
  border-color: #007bff;
}
.collie-nav .page-item .page-link img{
  width: 30px;
  height: 60px;
}
.collie-nav .page-item .page-link {
  border-radius: 50% !important;
  height: 5.5rem;
  width: 5.5rem;
  line-height: 2.8rem;
  text-align: center;
}

#total_collies.input-group,
#total_weight.input-group{
  max-width: 400px;
}

#total_collies.input-group .btn,
#total_weight.input-group .btn{
  border-radius: 50% !important;
  height: 4rem;
  line-height: 2.8rem;
  font-size: 2rem;
  width: 4rem;
}
#total_collies.input-group input.form-control,
#total_weight.input-group input.form-control{
 border: none;
  text-align: center;
  font-size: 2rem;
  max-width: 200px;
}

#total_collies.input-group label,
#total_weight.input-group label{
  line-height: 2.8rem;
  width: 60px !important;
  font-weight: bold;
}

tfoot tr.footer{
  border-width: 2px 0 2px 0;
  border-color: #0c3b44;
  border-style: solid;
}

.collie-type-footer button{
  border-radius: 50% !important;
  height: 10em;
  width: 10em;
}

.print-button img, .pallet-button img{
  width: 6.5em;
  height: 6.5em;
}
.cc-koopman{
  width: 6.5em;
  height: 6.5em;
  line-height: 6.5em;
  border-radius: 0!important;
}

.collie-table td{
  padding:0!important;
}
</style>
